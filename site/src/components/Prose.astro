---
// One place for long-form typography, so every page reads identically and a
// spacing change happens once rather than in eight templates.
---
<div
  class="max-w-none space-y-5 leading-relaxed text-text-muted
         [&_a]:text-primary-400 [&_a]:underline [&_a]:underline-offset-4 hover:[&_a]:text-primary-300
         [&_strong]:font-semibold [&_strong]:text-text
         [&_code]:rounded [&_code]:bg-surface-elevated [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-[0.9em] [&_code]:text-primary-300
         [&_h2]:mt-12 [&_h2]:scroll-mt-20 [&_h2]:font-heading [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-text
         [&_h3]:mt-8 [&_h3]:scroll-mt-20 [&_h3]:font-heading [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-text
         [&_li]:ml-5 [&_li]:list-disc [&_li]:marker:text-primary-700
         [&_pre]:overflow-x-auto [&_pre]:rounded-lg [&_pre]:border [&_pre]:border-border [&_pre]:bg-surface [&_pre]:p-4 [&_pre]:text-sm
         [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_pre_code]:text-text"
>
  <slot />
</div>
