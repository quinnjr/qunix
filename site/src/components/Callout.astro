---
interface Props {
  tone?: 'note' | 'warn' | 'good';
  title: string;
}
const { tone = 'note', title } = Astro.props;

const tones = {
  note: 'border-info-500/40 bg-info-500/5',
  warn: 'border-warning-500/40 bg-warning-500/5',
  good: 'border-success-500/40 bg-success-500/5',
};
const marks = { note: 'text-info-500', warn: 'text-warning-500', good: 'text-success-500' };
---

<aside class:list={['my-6 rounded-lg border p-5', tones[tone]]}>
  <p class:list={['mb-2 font-heading text-sm font-semibold tracking-wide uppercase', marks[tone]]}>
    {title}
  </p>
  <div class="space-y-3 text-text-muted [&_code]:text-primary-300">
    <slot />
  </div>
</aside>
